{
    "compilerOptions": {
      "target": "ESNext",
      "module": "CommonJS",
      "moduleResolution": "node",
      "strict": true,
      "esModuleInterop": true,
      "outDir": "./dist",
      "baseUrl": ".",
      "paths": {}
    },
    "include": [
      "tests/**/*.ts",
      "pages/**/*.ts",
      "fixtures/**/*.ts"
    ],
    "exclude": [
      "node_modules"
    ]
  }